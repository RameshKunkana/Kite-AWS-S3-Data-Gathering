KITE_API_KEY=
KITE_ACCESS_TOKEN=
# KITE_ACCESS_TOKEN_FILE=/home/ec2-user/secrets/kite_access_token.txt
AWS_REGION=ap-south-1
KINESIS_STREAM_NAME=drify-market-data-stream
KINESIS_PARTITION_KEY=market-ticks
LOG_LEVEL=INFO

OPTION_STRIKE_WINDOW=15
NIFTY_STRIKE_STEP=50
SENSEX_STRIKE_STEP=100
BASKET_REFERENCE_MODE=last_price

KITE_INDEX_MODE=quote
KITE_DERIVATIVE_MODE=full
KITE_RECONNECT_MAX_TRIES=50
KITE_RECONNECT_MAX_DELAY=60
KITE_CONNECT_TIMEOUT=30

KINESIS_PUBLISH_RETRIES=3
KINESIS_PUBLISH_BACKOFF_SECONDS=1.0

PREMARKET_START_TIME=09:00
PREMARKET_END_TIME=09:08
BASKET_SELECTION_TIME=09:10
MARKET_START_TIME=09:15
MARKET_END_TIME=15:30

# NSE market holidays 2026 — update annually from NSE circular
MARKET_HOLIDAYS=2026-01-15,2026-01-26,2026-03-03,2026-03-26,2026-03-31,2026-04-03,2026-04-14,2026-05-01,2026-05-28,2026-06-26,2026-09-14,2026-10-02,2026-10-20,2026-11-10,2026-11-24,2026-12-25
